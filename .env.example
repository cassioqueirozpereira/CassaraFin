# Exemplo de Variáveis de Ambiente (CassaraFin)
# Copie este arquivo para .env.local para desenvolvimento local
# E adicione no painel da Vercel (Project Settings > Environment Variables) para produção.

# Banco de Dados PostgreSQL / Supabase
DATABASE_URL="postgresql://postgres:sua_senha@localhost:5432/cassarafin"

# Autenticação Google OAuth Oficial (Google Cloud Console)
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="seu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# URL pública do site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
